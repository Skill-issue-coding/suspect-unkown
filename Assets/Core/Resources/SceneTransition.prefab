  m_Script: {fileID: 11500000, guid: 013810fad87cd4e4687f0a6e63355515, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::SceneTransitionView
  cover: {fileID: 525946492151400494}
  title: {fileID: 3015311122026178429}
  tip: {fileID: 8140851873837161669}
  barFill: {fileID: 158329532991032120}
  sketch: {fileID: 2014428241592232167}
  scanLine: {fileID: 2484541966558396665}
  destinations:
  - scene: Apartment
    title: THE APARTMENT
  - scene: MainMenu
    title: SAFEHOUSE
  - scene: Thriftshop
    title: THE THRIFT STORE
  tips:
  - Light makes you easier to see. Cross the dark gaps between lamps.
  - Sprinting is loud. Indoors, one sprint can wake a dozing tenant from the next room.
  - 'Crouch behind low cover: hidden legs and feet tell a witness nothing about your shoes.'
  - Break line of sight while someone reaches for the phone, and the call never happens.
  - Taking loot in plain view is the worst thing to be seen doing.
  - Picking a lock in view raises suspicion fast. Pick where nobody is looking.
  - The police remember what you wore. Change clothes between jobs.
  - Your bag holds two items. Cash goes in your pockets and never takes a slot.
  - Every job ends at the van. Stand at its back doors until the marker fills.
  - No alarm raised means bonus reputation. A quiet job also pays more than a loud one.
  - Every reputation level is worth a skill point.
  coverSeconds: 0.4
  minShownSeconds: 0.6
  revealSeconds: 0.5
  barSpeed: 2.5
  tipSeconds: 3.5
  tipFade: 0.35
  scanSeconds: 1.2
